# Development environment variables for Vercel build
BETTER_AUTH_SECRET=dev-secret-key-at-least-32-chars-long-for-build
BETTER_AUTH_URL=http://localhost:3000
ENCRYPTION_KEY=dev-encryption-key-at-least-32-chars
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_telegram
TELEGRAM_BOT_TOKEN=placeholder-telegram-token
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=https://placeholder.upstash.io
UPSTASH_REDIS_REST_TOKEN=placeholder-token
RATE_LIMIT_SECRET=dev-rate-limit-secret-at-least-32-chars
DISABLE_TWOFACTOR=1
VEOPAG_BASE_URL=https://api.veopag.com
VEOPAG_PUBLIC_KEY=placeholder-public-key
VEOPAG_SECRET_KEY=placeholder-secret-key
