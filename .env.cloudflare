# ============================================================
# Cloudflare + Telegram Webhook Configuration
# ============================================================
# This file documents the environment variables needed when
# running behind Cloudflare. Copy relevant values to your
# actual .env file (production environment).
#
# CLOUDFLARE_TRUST_IPS=true
#   When set, the app trusts CF-Connecting-IP as the canonical
#   source of the client IP address (already handled in code).
#
# NODE_ENV=production
#   Enables Telegram IP whitelist validation on webhook endpoint.
#
# BETTER_AUTH_URL=https://seu-dominio.com
#   Override the base URL to your Cloudflare-managed domain
#   (required so setWebhook registers the correct URL with Telegram).
# ============================================================
