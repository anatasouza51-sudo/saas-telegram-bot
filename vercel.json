{
  "buildCommand": "npm install --os=linux --cpu=x64 sharp && next build",
  "crons": [
    {
      "path": "/api/tg/cron",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "app/api/tg/upload/**": {
      "maxDuration": 60
    },
    "app/api/telegram/webhook/**": {
      "maxDuration": 30
    }
  }
}
